; Kotlin function definitions and `return`s for refactoring.nvim (not bundled upstream).
; Used by inline function to find the function under the cursor and its single
; `return`. The inlined lines themselves are generated by
; `lua/refactoring-kotlin/kotlin.lua` (arguments substituted into the body).
; Empty bodies (`fun f() {}`) are not supported.

; Block-bodied functions: `fun f(a: Int): Int { ... }`
; The `","` sequence (instead of `(parameter)*`) keeps all the args in a single match.
(([
  (line_comment)
  (multiline_comment)
]* @function.comment)
  .
  (function_declaration
    (function_value_parameters
      ((parameter
        (simple_identifier) @function.arg)
        (","
          (parameter
            (simple_identifier) @function.arg))*)?)
    (function_body
      (statements) @function.body)) @function)

; Expression-bodied functions: `fun f(a: Int) = a * 2`
; `= expr` is treated as a body with no statements plus an implicit `return expr`
; (the plugin copies the body up to the `return`, so nothing but the value is inlined).
(([
  (line_comment)
  (multiline_comment)
]* @function.comment)
  .
  (function_declaration
    (function_value_parameters
      ((parameter
        (simple_identifier) @function.arg)
        (","
          (parameter
            (simple_identifier) @function.arg))*)?)
    (function_body
      "="
      (_) @return.value) @function.body @return) @function)

(jump_expression
  "return"
  (_)? @return.value) @return
